server.port=8080
spring.application.name=nexora-backend

spring.datasource.url=jdbc:postgresql://localhost:5432/nexora
spring.datasource.username=postgres
spring.datasource.password=your password


# Gemini API Keys (Get from https://aistudio.google.com/)
gemini.api.key.primary=YOUR_PRIMARY_GEMINI_API_KEY
gemini.api.key.secondary=YOUR_SECONDARY_GEMINI_API_KEY
gemini.api.model=gemini-flash-latest

spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true

jwt.secret=jwt key
jwt.expiration=900000
jwt.refresh-expiration=604800000

# Redis
spring.data.redis.host=localhost
spring.data.redis.port=6379

# Mail (configure for your SMTP provider)
spring.mail.host=smtp.gmail.com
spring.mail.port=587
spring.mail.username=${MAIL_USERNAME:}
spring.mail.password=${MAIL_PASSWORD:}
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true
nexora.mail.from=${MAIL_FROM:}
nexora.frontend-url=${FRONTEND_URL:http://localhost:5173}
nexora.email-verification.expiration-hours=24

# OTP
nexora.otp.expiration-minutes=10
nexora.otp.length=6
nexora.otp.resend-max-attempts=2
nexora.otp.resend-window-minutes=60

# Admin bootstrap (first startup only — skipped if any ADMIN user already exists)
# Login after bootstrap: identifier = admin@nexora.com OR username "admin"
ADMIN_EMAIL=
ADMIN_PASSWORD=

# AES encryption for sensitive fields (32-byte hex or base64 key)
nexora.encryption.key=${ENCRYPTION_KEY:}

# Security / JWT
jwt.secret=YOUR_JWT_SECRET_MIN_64_CHARS
jwt.expiration=900000
jwt.refresh-expiration=604800000
